{
  "$schema": "./appsettings-schema.json",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Umbraco.Cms.Tests": "Information"
    },
    "Console": {
      "DisableColors": true
    }
  },
  "Tests": {
    "Database": {
      "DatabaseType": "SQLite", // "SqlServer", "SQLite", "LocalDb"
      "PrepareThreadCount": 4,
      "SchemaDatabaseCount": 4,
      "EmptyDatabasesCount": 2
    }
  },
  "OtherExamplesOfTestSettings": {
    // copy "Database" section to "Database" of "Tests" and adjust the values to run tests against your database.
    "SQLite_Tests": {
      "Database": {
        "DatabaseType": "SQLite",
        "PrepareThreadCount": 4,
        "SchemaDatabaseCount": 4,
        "EmptyDatabasesCount": 2
      }
    },
    "SqlServer_Tests": {
      "Database": {
        "DatabaseType": "SqlServer",
        "PrepareThreadCount": 4,
        "SchemaDatabaseCount": 4,
        "EmptyDatabasesCount": 2,
        "SQLServerMasterConnectionString": "Server=[SQL_SERVER_NAME];Database=UmbracoTest-1;Integrated Security=true;TrustServerCertificate=true;" // you need to create databse "UmbracoTest-1" first.
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Content": {
        "AllowedUploadedFileExtensions": [ "jpg", "png", "gif", "svg" ]
      }
    }
  }
}
