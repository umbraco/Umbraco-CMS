<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Umbraco CMS - Persistence - Entity Framework Core - SQL Server migrations</Title>
    <Description>Adds support for Entity Framework Core SQL Server migrations to Umbraco CMS.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Not referenced from code: Microsoft.Data.SqlClient discovers this assembly at runtime and registers the
      Microsoft Entra ID authentication providers (e.g. "Active Directory Managed Identity") from it. Without it,
      connection strings using those authentication modes fail.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Cms.Persistence.EFCore\Umbraco.Cms.Persistence.EFCore.csproj" />
  </ItemGroup>
</Project>
