<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Umbraco CMS - Imaging - ImageSharp 2</Title>
    <Description>Adds imaging support using ImageSharp/ImageSharp.Web version 2 to Umbraco CMS.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" VersionOverride="[2.1.13, 3)" />
    <PackageReference Include="SixLabors.ImageSharp.Web" VersionOverride="[2.0.2, 3)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Web.Common\Umbraco.Web.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Shared with the ImageSharp 3.x package rather than copied. Neither file touches an API that
      differs between the two majors, and the packages cannot share an assembly because they depend
      on mutually exclusive versions of SixLabors.ImageSharp, so linking the source is the only way
      to keep one copy. Everything else in this project is a deliberate variant of its counterpart.
    -->
    <Compile Include="..\Umbraco.Cms.Imaging.ImageSharp\ImageProcessingMemory.cs" Link="ImageProcessingMemory.cs" />
    <Compile Include="..\Umbraco.Cms.Imaging.ImageSharp\ImageProcessingThrottle.cs" Link="ImageProcessingThrottle.cs" />
    <Compile Include="..\Umbraco.Cms.Imaging.ImageSharp\ConfigurePhysicalFileSystemCacheOptions.cs" Link="ConfigurePhysicalFileSystemCacheOptions.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Umbraco.Tests.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
